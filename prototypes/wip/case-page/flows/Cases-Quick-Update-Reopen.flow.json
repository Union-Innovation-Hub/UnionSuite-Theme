        {
          "activityId": "a0a49466-6af9-4811-8db2-3c5f7570480b",
          "type": "RunJavaScript",
          "name": "CreateLogContext",
          "displayName": "JS: Create Log Context",
          "x": 40,
          "y": 2540,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// One change-log entry: the case's status, from closed back to the one it\n// reopens to (JS_ChooseStatus), under the i4u_UT_Cases column name.\nvar endpoint = activities.EndpointData.Output();\nvar body = endpoint.Body;\nvar reopen = getVariable('Reopen');\n\nvar logContext = {\n    \"Note\": \"Case \" + body.CaseID + \": Reopened\",\n    \"Table\": \"i4u_UT_Cases\",\n    \"UpdateReason\": \"Edit\",\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\n    \"sourceOrdinal\": String(body.CaseNum) // the case's ordinal\n};\n\n// Names must match the keys in logBody.\nvar fieldsToCompare = [\"Status\"];\n\nvar logBody = {\n    \"Status\": String(reopen.status),\n    \"OldValue\": JSON.stringify({\"Status\": String(reopen.current)})\n};\n\nsetVariable('logChanges', {\n    \"logContext\": logContext, // DON'T CHANGE\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\n    \"body\": logBody,\n    \"profileID\": String(body.CaseID), // the case the change belongs to\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\n});"
              }
            },
            {
              "name": "PossibleOutcomes",
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
