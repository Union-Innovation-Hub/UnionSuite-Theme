        {
          "activityId": "3cba75ac-ab0d-4568-8847-92a7b776693b",
          "type": "RunJavaScript",
          "name": "JS_ChooseStatus",
          "displayName": "JS: Choose Reopen Status",
          "description": null,
          "x": 40,
          "y": 1290,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// Which status the case goes back to (owner, 17 November 2026): the one\n// it had before it was resolved, from the change log (IQA_GetPreviousStatus:\n// the newest i4u_UT_Logging Status rows, newest first), the first whose Old\n// is still an open status in the Case Status value list: with several\n// closed statuses, Edit resolution can log Won → Lost, which is skipped. Otherwise In Progress, or the\n// list's first open status. Columns are matched whatever their case,\n// spaces or underscores, as Set Status matches them.\nvar key = function (name) { return String(name).replace(/[\\s_]/g, '').toLowerCase(); };\nvar get = function (row, name) {\n  var column = Object.keys(row || {}).find(function (each) { return key(each) === key(name); });\n  return column === undefined ? undefined : row[column];\n};\nvar text = function (value) { return String(value ?? '').trim(); };\nvar read = function (fn) { try { return Array.from(fn() || []); } catch (error) { return []; } };\n\nvar statuses = read(function () { return activities.IQA_StatusList.ResultSet(); });\nvar entry = function (code) {\n  return statuses.find(function (row) { return text(get(row, 'Code')).toLowerCase() === text(code).toLowerCase(); });\n};\nvar isOpen = function (code) {\n  var row = entry(code);\n  return text(code) !== '' && !!row && !/^(true|1|yes|y)$/i.test(text(get(row, 'Closed Status')));\n};\n\nvar current = text(activities.SQL_Validation.ResultSet()[0].OldStatus);\nvar logged = read(function () { return activities.IQA_GetPreviousStatus.ResultSet(); });\nvar previous = logged.map(function (row) { return text(get(row, 'Old')); }).find(isOpen) || '';\n\nvar firstOpen = statuses.map(function (row) { return text(get(row, 'Code')); }).find(isOpen) || '';\nvar fallback = isOpen('InProgress') ? 'InProgress' : firstOpen;\n\nsetVariable('Reopen', {\n  current: current,\n  // Already open (another tab, or a second click): nothing to do.\n  alreadyOpen: isOpen(current),\n  status: isOpen(previous) ? previous : fallback,\n  fromLog: isOpen(previous)\n});"
              }
            },
            {
              "name": "PossibleOutcomes",
              "syntax": null,
              "expressions": {}
            }
          ],
          "propertyStorageProviders": {}
        },
