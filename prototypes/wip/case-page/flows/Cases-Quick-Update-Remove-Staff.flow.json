                "Literal": "// UPDATE LOG CONTEXT HERE\r\nvar endpoint = activities.EndpointData.Output();\r\nvar body = endpoint.Body;\r\nvar staff = activities.SQL_Validation.ResultSet()[0]; // the staff row and the case's lead, read before the delete\r\n\r\nvar logContext = {\r\n    \"Note\": \"Case \" + body.CaseID + \": Remove Staff (\" + staff.StaffId + \")\", // UPDATE HERE\r\n    \"Table\": \"i4u_UT_Cases_Staff\", // UPDATE HERE\r\n    \"UpdateReason\": \"Delete\", // UPDATE HERE\r\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\r\n    \"sourceOrdinal\": String(body.StaffOrdinal) // the removed case staff row's ordinal\r\n}\r\n// EMPTY: DELETE - the logging flow writes one row for the removal. A Delete's\r\n// change-history card shows its Note as the summary.\r\nvar fieldsToCompare = [];\r\n\r\n// The removed row's values, under the i4u_UT_Cases_Staff column names.\r\nvar logBody = {\r\n    \"StaffId\": String(staff.StaffId ?? \"\"),\r\n    \"StaffType\": String(staff.StaffType ?? \"\")\r\n}\r\n\r\n// compile all variables into one object\r\nvar logChanges = {\r\n    \"logContext\": logContext, // DON'T CHANGE\r\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\r\n    \"body\": logBody,\r\n    \"profileID\": String(body.CaseID), // the case the change belongs to\r\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\r\n}\r\nsetVariable('logChanges', logChanges);\r\n\r\n// When they were the lead, a second entry on the case: StaffLeadID old -> blank.\r\n// Sent by LogLeadChangeToIMIS only when WasLead.\r\nsetVariable('logLeadChange', {\r\n    \"logContext\": {\r\n        \"Note\": \"Case \" + body.CaseID + \": Clear Lead Staff\",\r\n        \"Table\": \"i4u_UT_Cases\",\r\n        \"UpdateReason\": \"Edit\",\r\n        \"workflowDefinitionId\": workflowDefinitionId,\r\n        \"sourceOrdinal\": String(body.CaseNum) // the case's ordinal\r\n    },\r\n    \"fieldsToCompare\": [\"StaffLeadID\"],\r\n    \"body\": {\r\n        \"StaffLeadID\": \"\",\r\n        \"OldValue\": JSON.stringify({ \"StaffLeadID\": String(staff.OldStaffLeadID ?? \"\") })\r\n    },\r\n    \"profileID\": String(body.CaseID),\r\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\r\n});"
              }
            },
