            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "DECLARE @CaseOrd int = TRY_CAST(@CaseOrdinal AS int);\r\nDECLARE @StaffOrd int = TRY_CAST(@StaffOrdinal AS int);\r\n\r\nDECLARE @EntityCode AS varchar(20) = COALESCE(\r\n  (SELECT TOP 1 OrgCode FROM [Cases].[i4u_UT_Cases] WHERE Ordinal = @CaseOrd),\r\n  (SELECT TOP 1 EntityCode FROM [ZenCrm].[Individuals] WHERE ImisId = @LoggedInUser),\r\n  (SELECT TOP 1 OrgCode FROM UnionTemplate.Entities WHERE IsDefault = 1) -- Final fallback, default org code\r\n);\r\nDECLARE @localTimestamp datetime = COALESCE([UnionTemplate].fn_GetDateTimeWithTimeZone(@EntityCode), GETUTCDATE());\r\n\r\nDECLARE @message varchar(4000) = '';\r\n\r\n-- check if case exists\r\nIF NOT EXISTS (\r\n\tSELECT *\r\n\tFROM Cases.i4u_UT_Cases\r\n\tWHERE CaseID = @CaseID\r\n\t\tAND Ordinal = @CaseOrd\r\n)\r\n\tSET @message += 'Case is not valid. | ';\r\n\r\n-- check if users entity matches case\r\nIF NOT EXISTS (\r\n\tSELECT *\r\n\tFROM Cases.i4u_UT_Cases C\r\n\tINNER JOIN UnionTemplate.EntityAccess A\r\n\t\tON C.OrgCode = A.EntityCode\r\n\tWHERE C.CaseID = @CaseID\r\n\t\tAND C.Ordinal = @CaseOrd\r\n\t\tAND A.StaffimisID = @LoggedInUser\r\n)\r\n\tSET @message += 'Unauthorised entity | ';\r\n\r\n-- The staff row, on this case only, as it is before the change.\r\nDECLARE @Found int = 0;\r\nDECLARE @RowStaffId varchar(20) = NULL;\r\nDECLARE @RowStaffType varchar(150) = NULL;\r\nSELECT TOP 1\r\n\t@Found = 1,\r\n\t@RowStaffId = LTRIM(RTRIM(CAST(StaffId AS varchar(20)))),\r\n\t@RowStaffType = CAST(StaffType AS varchar(150))\r\nFROM Cases.i4u_UT_Cases_Staff\r\nWHERE Ordinal = @StaffOrd\r\n\tAND CaseOrdinal = @CaseOrd;\r\n\r\n-- The case's lead before the change: cleared below when it is this person.\r\nDECLARE @OldLeadId varchar(20) = (\r\n\tSELECT TOP 1 LTRIM(RTRIM(CAST(StaffLeadID AS varchar(20))))\r\n\tFROM Cases.i4u_UT_Cases\r\n\tWHERE Ordinal = @CaseOrd\r\n\t\tAND CaseID = @CaseID\r\n);\r\n\r\n-- The row is there but for someone else: the page is out of date.\r\nIF @Found = 1 AND ISNULL(@RowStaffId, '') <> LTRIM(RTRIM(ISNULL(@StaffID, '')))\r\n\tSET @message += 'Staff member not on this case. | ';\r\n\r\n-- No row: already removed (another tab, or a resend as the page closed).\r\n-- Valid, and the flow answers 200 without writing or logging.\r\nSELECT\r\n\tCASE WHEN @message = '' THEN 1 ELSE 0 END AS [Valid],\r\n\t@message AS [Message],\r\n\tCONVERT(varchar(23), @localTimestamp, 126) AS [Timestamp],\r\n\tCASE WHEN @Found = 0 THEN 1 ELSE 0 END AS [AlreadyRemoved],\r\n\tCASE WHEN @Found = 1 AND NULLIF(@OldLeadId, '') = @RowStaffId THEN 1 ELSE 0 END AS [WasLead],\r\n\t@RowStaffId AS [StaffId],\r\n\t@RowStaffType AS [StaffType],\r\n\t@OldLeadId AS [OldStaffLeadID];\r\n"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "Grid": "[{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@CaseOrdinal\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Body.CaseNum\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@CaseID\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Body.CaseID\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@StaffOrdinal\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Body.StaffOrdinal\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@StaffID\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Body.StaffID\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@LoggedInUser\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Headers.loggedinpartyid\"}}}]",
                "JavaScript": "JSON.stringify([{\"Name\":\"@CaseOrdinal\",\"Value\":String((activities.EndpointData.Output().Body.CaseNum) ?? \"\")},{\"Name\":\"@CaseID\",\"Value\":String((activities.EndpointData.Output().Body.CaseID) ?? \"\")},{\"Name\":\"@StaffOrdinal\",\"Value\":String((activities.EndpointData.Output().Body.StaffOrdinal) ?? \"\")},{\"Name\":\"@StaffID\",\"Value\":String((activities.EndpointData.Output().Body.StaffID) ?? \"\")},{\"Name\":\"@LoggedInUser\",\"Value\":String((activities.EndpointData.Output().Headers.loggedinpartyid) ?? \"\")}])"
              }
