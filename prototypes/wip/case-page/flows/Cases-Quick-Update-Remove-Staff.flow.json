              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "SET XACT_ABORT ON;\r\nBEGIN TRANSACTION;\r\n\r\nDELETE\r\nFROM [Cases].[i4u_UT_Cases_Staff]\r\nWHERE Ordinal = @StaffOrdinal\r\n\tAND CaseOrdinal = @CaseOrdinal;\r\n\r\n-- They were the lead: the case has no lead until someone is made lead.\r\nIF @WasLead = '1'\r\n\tUPDATE [Cases].[i4u_UT_Cases]\r\n\tSET StaffLeadID = NULL,\r\n\t\tLastUpdatedBy = @LoggedInUser,\r\n\t\tLastUpdateOn = @LocalTimestamp\r\n\tWHERE Ordinal = @CaseOrdinal;\r\n\r\nCOMMIT TRANSACTION;"
