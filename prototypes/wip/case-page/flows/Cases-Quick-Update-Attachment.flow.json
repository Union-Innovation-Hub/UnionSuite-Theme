")\",\n    \"Table\": \"Zen_CloudFiles_Storage\",\n    \"UpdateReason\": \"Edit\",\n    \"workflowDefinitionId\": workflowDefinitionId, // provided by CloudToolz\n    \"sourceOrdinal\": String(body.FileOrdinal) // the file's ordinal\n};\n\n// An Edit's old values travel as the OldValue JSON string.\nvar logChanges = {\n    \"logContext\": logContext,\n    \"fieldsToCompare\": fieldsToCompare,\n    \"body\": {\n        \"FileName\": newValues.FileName,\n        \"Tags\": newValues.Tags,\n        \"OldValue\": JSON.stringify(oldValues)\n    },\n    \"profileID\": String(body.CaseID), // the case the change belongs to\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\n};\nsetVariable(\"logChanges\", logChanges);"}},{"$id":"183","name":"PossibleOutcomes","expressions":{"$id":"184"}}],"propertyStorageProviders":{"$id":"185"}},{"$id":"186","activityId":"0159b4f9-41bc-40e0-8a95-be03c2ff04d5","type":"If","displayName":"IF: Anything Changed","x":40,"y":3655,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"187","name":"Condition","syntax":"JavaScript","expressions":{"$id":"188","JavaScript":"getVariable('HasChanges') === true"}}],"propertyStorageProviders":{"$id":"189"}},{"$id":"190","activityId":"860cf744-ac3d-4808-8ced-b60f27706ed6","type":"RunWorkflow","name":"LogChangesToIMIS","displayName":"Log Changes To IMIS","x":40,"y":3906,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"191","name":"WorkflowDefinitionId","syntax":"JavaScript","expressions":{"$id":"192","JavaScript":"getWorkflowDefinitionIdByName('LogChangesToIMIS')"}},{"$id":"193","name":"Input","syntax":"JavaScript","expressions":{"$id":"194","JavaScript":"getVariable('logChanges')"}},{"$id":"195","name":"PossibleOutcomes","expressions":{"$id":"196"}},{"$id":"197","name":"Mode","expressions":{"$id":"198","Literal":"FireAndForget"}},{"$id":"199","name":"TenantId","expressions":{"$id":"200"}},{"$id":"201","n