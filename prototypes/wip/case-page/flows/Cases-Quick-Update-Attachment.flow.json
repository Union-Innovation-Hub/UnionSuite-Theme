2"}},{"$id":"23","name":"CustomHeaderValue","expressions":{"$id":"24"}},{"$id":"25","name":"ValidateCallerUrl","expressions":{"$id":"26"}},{"$id":"27","name":"ValidateImisRequest","expressions":{"$id":"28","Literal":"true"}},{"$id":"29","name":"ImisRequestVerificationRole","expressions":{"$id":"30"}},{"$id":"31","name":"ValidateOutlookPluginToken","expressions":{"$id":"32"}},{"$id":"33","name":"RequiredOutlookPluginUsername","expressions":{"$id":"34"}},{"$id":"35","name":"OutlookPluginMailboxEmail","expressions":{"$id":"36"}}],"propertyStorageProviders":{"$id":"37"}},{"activityId":"cd66cb08-3412-4d44-9244-224a75980b45","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_Validation","displayName":"SQL - Validation and Timestamp","description":null,"x":275,"y":314,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"name":"ExpectedResults","syntax":null,"expressions":{"Literal":"Result Set"}},{"name":"ConnectionId","syntax":null,"expressions":{"Literal":"default"}},{"name":"Script","syntax":"Literal","expressions":{"Literal":"DECLARE @EntityCode AS varchar(20) = COALESCE(\r\n  (SELECT OrgCode FROM [Cases].[i4u_UT_Cases] WHERE Ordinal = @CaseOrdinal), -- this would be @ImisID\r\n  (SELECT EntityCode FROM [ZenCrm].[Individuals] WHERE ImisId = @LoggedInUser),  -- this would be @LoggedInUserID\r\n  (SELECT OrgCode FROM UnionTemplate.Entities WHERE IsDefault = 1) -- Final fallback, default org code\r\n);\r\nDECLARE @localTimestamp datetime = COALESCE([UnionTemplate].fn_GetDateTimeWithTimeZone(@EntityCode), GETUTCDATE());\r\n\r\n\r\nDECLARE @valid int = 1\r\nDECLARE @message varchar(4000) = ''\r\nSET @message = ''\r\n\r\n-- check if case exists\r\nIF NOT EXISTS (\r\n\tSELECT * \r\n\tFROM Cases.i4u_UT_Cases\r\n\tWHERE CaseID = @CaseID\r\n\t\tAND Ordinal = @CaseOrdinal\r\n)\r\n    SET @message += 'Case is not valid. | '\r\n\r\n-- check if users entity matches case\r\nIF NOT EXISTS (\r\n\tSELECT * \r\n\tFROM Cases.i4u_UT_Cases C\r\n\tINNER JOIN UnionTemplate.EntityAccess A\r\n\t\tON C.OrgCode = A.EntityCode\r\n\tWHERE CaseID = @CaseID\r\n\t\tAND C.Ordinal = @CaseOrdinal\r\n\t\tAND A.StaffimisID = @loggedInUser\r\n)\r\n    SET @message += 'Unauthorised entity | '\r\n\r\nIF @message <> ''\r\n\tSET @valid = 0\r\n\r\nSELECT \r\n\t@valid AS [Valid],\r\n\t@message AS [Message],\r\n\tCONVERT(varchar(23), @localTimestamp, 126) AS [Timestamp];\r\n"}},{"name":"Parameters","syntax":"JavaScript","expressions":{"Grid":"[{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@CaseOrdinal\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"activity\",\"JavaScript\":\"activities.EndpointData.Output().Body.CaseNum\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@CaseID\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Body.CaseID\"}}},{\"Name\":{\"syntax\":\"Literal\",\"expressions\":{\"Literal\":\"@loggedInUser\",\"JavaScript\":\"\"}},\"Value\":{\"syntax\":\"JavaScript\",\"expressions\":{\"Literal\":\"\",\"JavaScript\":\"activities.EndpointData.Output().Headers.loggedinpartyid\"}}}]","JavaScript":"JSON.stringify([{\"Name\":\"@CaseOrdinal\",\"Value\":String((activities.EndpointData.Output().Body.CaseNum) ?? \"\")},{\"Name\":\"@CaseID\",\"Value\":String((activities.EndpointData.Output().Body.CaseID) ?? \"\")},{\"Name\":\"@loggedInUser\",\"Value\":String((activities.EndpointData.Output().Headers.loggedinpartyid) ?? \"\")}])"}},{"name":"Timeout","syntax":null,"expressions":{}},{"name":"StrictlySelectOnly","syntax":null,"expressions":{}}],"propertyStorageProviders":{}},{"activityId":"780fb5b2-0f4b-45d2-8183-56a4c4902f44","type":"If","name":null,"displayName":"IF: Case Valid","description":null,"x":275,"y":565,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"name":"Condition","syntax":"JavaScript","expressions":{"JavaScript":"activities.SQL_Validation.ResultSet()[0].Valid == 1"}}],"propertyStorageProviders":{}},{"activityId":"01614db9-428d-47c9-ba14-b0d345739d16","type":"WriteHttpResponse","name":null,"displayName":"HTTP Response - Case Not Valid","description":null,"x":745,"y":565,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"name":"Content","syntax":null,"expressions":{"Literal":"Case not valid"}},{"name":"ContentType","syntax":null,"expressions":{"Literal":"text/plain"}},{"name":"StatusCode","syntax":null,"expressions":{"Literal":"BadRequest"}},{"name":"CharSet","syntax":null,"expressions":{"Literal":"utf-8"}},{"name":"ResponseHeaders","syntax":null,"expressions":{}}],"propertyStorageProviders":{}},{"activityId":"fba886e1-c0cc-4f53-9610-33e9a46bbb38","type":"WriteHttpResponse","name":null,"displayName":"HTTP Response - General Error","description":null,"x":745,"y":314,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"name":"Content","syntax":null,"expressions":{"Literal":"An unexpected error occurred. Please contact a system adminstrator."}},{"name":"ContentType","syntax":null,"expressions":{"Literal":"text/plain"}},{"name":"StatusCode","syntax":null,"expressions":{"Literal":"InternalServerError"}},{"name":"CharSet","syntax":null,"expressions":{"Literal":"utf-8"}},{"name":"ResponseHeaders","syntax":null,"expressions":{}}],"propertyStorageProviders":{}},{"$id":"38","activityId":"28a1f6a4-d58a-4aaa-8dfe-dda79f70ed9d","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_CurrentValues","displayName":"SQL: Current Values","x":40,"y":565,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"39","name":"ExpectedResults","expressions":{"$id":"40","Literal":"Result Set"}},{"$id":"41","name":"Script","expressions":{"$id":"42","Literal":"-- The file's member (ZCFS_ID), its name and tags as they are now, and the\n-- names of the tags picked: the change history's old and new values. Tags\n-- are compared as sorted names, so their order does not count as a change.\nSELECT\n    I.ImisID AS Zcfs_ID,\n    F.FileName AS OldFileName,\n    ISNULL((SELECT STRING_AGG(Tag.TagName, ', ') WITHIN GROUP (ORDER BY Tag.TagName)\n            FROM (SELECT DISTINCT T.TagName\n                  FROM [ZideBar].[Zen_CloudFiles_Tags] FT\n                  INNER JOIN [ZideBar].[Zen_Tags] T ON T.Ordinal = FT.TagOrdinal\n                  WHERE FT.ZCFS_Ordinal = F.Ordinal) Tag), '') AS OldTags,\n    ISNULL((SELECT STRING_AGG(Tag.TagName, ', ') WITHIN GROUP (ORDER BY Tag.TagName)\n            FROM (SELECT DISTINCT T.TagName\n                  FROM STRING_SPLIT(@tagOrdinals, ',') S\n                  INNER JOIN [ZideBar].[Zen_Tags] T ON S.value = T.Ordinal) Tag), '') AS NewTags\nFROM [ZideBar].[Zen_CloudFiles_Storage] F\nINNER JOIN [ZenCRM].[Individuals] I\n    ON F.CrmID = I.ID\nWHERE F.Ordinal = CAST(@fileOrdinal AS int)"}},{"$id":"43","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"44","JavaScript":"JSON.stringify([{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal},{Name:\"@tagOrdinals\",Value:String(activities.EndpointData.Output().Body.NewTagOrdinals ?? \"\")}])"}},{"$id":"45","name":"Timeout","expressions":{"$id":"46"}},{"$id":"47","name":"StrictlySelectOnly","expressions":{"$id":"48"}}],"propertyStorageProviders":{"$id":"49"}},{"$id":"50","activityId":"6d700179-8746-405a-a40f-681d073b3732","type":"RunJavaScript","name":"SetVariables","displayName":"JS: Set Variables","x":40,"y":816,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"51","name":"Script","syntax":"Literal","expressions":{"$id":"52","Literal":"// No row: the file is not in CloudToolz (or not a member's).\nvar row = activities.SQL_CurrentValues.ResultSet()[0] || {};\n// The case's local time, from the case check.\nsetVariable('Timestamp', activities.SQL_Validation.ResultSet()[0].Timestamp);\nsetVariable('ZcfsID', row.Zcfs_ID || '');\nsetVariable('OldFileName', row.OldFileName || '');\nsetVariable('OldTags', row.OldTags || '');\nsetVariable('NewTags', row.NewTags || '');"}},{"$id":"53","name":"PossibleOutcomes","expressions":{"$id":"54"}}],"propertyStorageProviders":{"$id":"55"}},{"$id":"56","activityId":"fec4ab8f-e0b0-405f-9188-d3e3c4250f35","type":"If","displayName":"IF: File Found","x":40,"y":1067,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"57","name":"Condition","syntax":"JavaScript","expressions":{"$id":"58","JavaScript":"getVariable('ZcfsID') !== ''"}}],"propertyStorageProviders":{"$id":"59"}},{"$id":"60","activityId":"9125617e-6b4c-4d56-a92f-123c2df30940","type":"WriteHttpResponse","displayName":"HTTP Response - File Not Found","x":510,"y":1318,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"61","name":"Content","expressions":{"$id":"62","Literal":"File not found"}},{"$id":"63","name":"ContentType","expressions":{"$id":"64","Literal":"text/plain"}},{"$id":"65","name":"StatusCode","expressions":{"$id":"66","Literal":"NotFound"}},{"$id":"67","name":"CharSet","expressions":{"$id":"68","Literal":"utf-8"}},{"$id":"69","name":"ResponseHeaders","expressions":{"$id":"70"}}],"propertyStorageProviders":{"$id":"71"}},{"$id":"72","activityId":"a2c38f50-32a1-4a71-abe6-d809a4e43452","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_TagsToAdd","displayName":"SQL: Tags To Add (iMIS rows)","x":40,"y":1318,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"73","name":"ExpectedResults","expressions":{"$id":"74","Literal":"Result Set"}},{"$id":"75","name":"Script","expressions":{"$id":"76","Literal":"-- NewTagOrdinals is every tag picked: the ones the file does not have yet\n-- are the rows to insert in iMIS.\nSELECT\n    T.Ordinal AS TagOrdinal,\n    @zcfsID AS ZCFS_ID,\n    @fileOrdinal AS ZCFS_Ordinal\nFROM STRING_SPLIT(@tagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_Tags] T\n    ON S.value = T.Ordinal\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM [ZideBar].[Zen_CloudFiles_Tags] Z\n    WHERE Z.TagOrdinal = T.Ordinal\n        AND Z.ZCFS_Ordinal = @fileOrdinal\n)"}},{"$id":"77","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"78","JavaScript":"JSON.stringify([{Name:\"@zcfsID\",Value:getVariable(\"ZcfsID\")},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal},{Name:\"@tagOrdinals\",Value:String(activities.EndpointData.Output().Body.NewTagOrdinals ?? \"\")}])"}},{"$id":"79","name":"Timeout","expressions":{"$id":"80"}},{"$id":"81","name":"StrictlySelectOnly","expressions":{"$id":"82"}}],"propertyStorageProviders":{"$id":"83"}},{"$id":"84","activityId":"45944c84-46f6-46c1-8956-abfc0e1bcec1","type":"BulkDataSourceOperation","displayName":"iMIS: Add Tags","x":40,"y":1569,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"85","name":"DataSource","expressions":{"$id":"86","Literal":"Standalone|Zen_CloudFiles_Tags|Multi"}},{"$id":"87","name":"DataSourceOperation","expressions":{"$id":"88","Literal":"Insert"}},{"$id":"89","name":"CollectionToProcess","syntax":"JavaScript","expressions":{"$id":"90","JavaScript":"activities.SQL_TagsToAdd.ResultSet()"}},{"$id":"91","name":"KeyField","expressions":{"$id":"92"}},{"$id":"93","name":"SwitchOnStopwatch","expressions":{"$id":"94"}},{"$id":"95","name":"MaxDegreeOfParallelism","expressions":{"$id":"96"}},{"$id":"97","name":"DataSourceType","expressions":{"$id":"98","Literal":""}}],"propertyStorageProviders":{"$id":"99"}},{"$id":"100","activityId":"42a28a46-cf8e-4706-8bd9-36bc72740eee","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_Filename","displayName":"SQL: Update Filename (and iMIS row)","x":40,"y":1846,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"101","name":"ExpectedResults","expressions":{"$id":"102","Literal":"Result Set"}},{"$id":"103","name":"Script","expressions":{"$id":"104","Literal":"-- Rename in CloudToolz\nUPDATE F\nSET FileName = @fileName,\n    LastUpdatedBy = @loggedInUser,\n    LastUpdatedOn = @timestamp\nFROM [ZideBar].[Zen_CloudFiles_Storage] F\nWHERE Ordinal = @fileOrdinal\n\n-- The row for the iMIS update\nSELECT\n    I.ImisID AS ID,\n    S.Ordinal,\n    S.FileName,\n    S.LastUpdatedBy,\n    S.LastUpdatedOn\nFROM [ZideBar].[Zen_CloudFiles_Storage] S\nINNER JOIN ZenCRM.[Individuals] I\n    ON S.CrmID = I.ID\nWHERE S.Ordinal = @fileOrdinal"}},{"$id":"105","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"106","JavaScript":"JSON.stringify([{Name:\"@timestamp\",Value:getVariable(\"Timestamp\")},{Name:\"@loggedInUser\",Value:activities.EndpointData.Output().Headers.loggedinpartyid},{Name:\"@fileName\",Value:activities.EndpointData.Output().Body.FileName},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal}])"}},{"$id":"107","name":"Timeout","expressions":{"$id":"108"}},{"$id":"109","name":"StrictlySelectOnly","expressions":{"$id":"110"}}],"propertyStorageProviders":{"$id":"111"}},{"$id":"112","activityId":"2856d09a-0b56-40c0-a18c-88393157c429","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_RemoveTags","displayName":"SQL: Remove Tags (and iMIS rows)","x":40,"y":2097,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"113","name":"ExpectedResults","expressions":{"$id":"114","Literal":"Result Set"}},{"$id":"115","name":"Script","expressions":{"$id":"116","Literal":"-- The rows for the iMIS delete\nSELECT T.*\nFROM STRING_SPLIT(@removedTagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_CloudFiles_Tags] T\n    ON S.value = T.TagOrdinal\nWHERE ZCFS_Ordinal = @fileOrdinal\n\n-- Remove them in CloudToolz\nDELETE T\nFROM STRING_SPLIT(@removedTagOrdinals, ',') S\nINNER JOIN [ZideBar].[Zen_CloudFiles_Tags] T\n    ON S.value = T.TagOrdinal\nWHERE ZCFS_Ordinal = @fileOrdinal"}},{"$id":"117","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"118","JavaScript":"JSON.stringify([{Name:\"@removedTagOrdinals\",Value:String(activities.EndpointData.Output().Body.RemovedTagOrdinals ?? \"\")},{Name:\"@fileOrdinal\",Value:activities.EndpointData.Output().Body.FileOrdinal}])"}},{"$id":"119","name":"Timeout","expressions":{"$id":"120"}},{"$id":"121","name":"StrictlySelectOnly","expressions":{"$id":"122"}}],"propertyStorageProviders":{"$id":"123"}},{"$id":"124","activityId":"f91e7dfa-9b43-43ae-994c-5610eb7b8885","type":"IntelligentQueryArchitectData","name":"IQA_iMISTags","displayName":"IQA: File Tags In iMIS","x":40,"y":2348,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"125","name":"IqaPath","expressions":{"$id":"126","Literal":"$/_i4u_/Core/Shared/API - Attachment Tags - By File Ordinal"}},{"$id":"127","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"128","JavaScript":"'&parameter=' + activities.EndpointData.Output().Body.FileOrdinal"}},{"$id":"129","name":"Offset","expressions":{"$id":"130"}},{"$id":"131","name":"Limit","expressions":{"$id":"132"}},{"$id":"133","name":"CollectionName","expressions":{"$id":"134"}}],"propertyStorageProviders":{"$id":"135"}},{"$id":"136","activityId":"2d23add5-76a0-42e1-b993-01cd7161e1aa","type":"ExecuteSqlAgainstCloudToolz","name":"SQL_CopyNewTags","displayName":"SQL: Copy New Tags From iMIS","x":40,"y":2599,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"137","name":"ExpectedResults","expressions":{"$id":"138","Literal":"Result Set"}},{"$id":"139","name":"Script","expressions":{"$id":"140","Literal":"-- The file's tags as iMIS has them, with iMIS's ordinals: only the ones\n-- CloudToolz lacks, and not the tags being removed (iMIS still has them\n-- until iMIS: Remove Tags runs).\nINSERT INTO [ZideBar].[Zen_CloudFiles_Tags] (\n    Ordinal,\n    TagOrdinal,\n    ZCFS_ID,\n    ZCFS_Ordinal\n)\nSELECT\n    JSON_VALUE(J.value, '$.Ordinal'),\n    JSON_VALUE(J.value, '$.TagOrdinal'),\n    JSON_VALUE(J.value, '$.ZCFS_ID'),\n    JSON_VALUE(J.value, '$.ZCFS_Ordinal')\nFROM OPENJSON(@imisTags) J\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM [ZideBar].[Zen_CloudFiles_Tags] Z\n    WHERE Z.Ordinal = JSON_VALUE(J.value, '$.Ordinal')\n)\nAND JSON_VALUE(J.value, '$.TagOrdinal') NOT IN (\n    SELECT LTRIM(S.value)\n    FROM STRING_SPLIT(@removedTagOrdinals, ',') S\n)"}},{"$id":"141","name":"Parameters","syntax":"JavaScript","expressions":{"$id":"142","JavaScript":"JSON.stringify([{Name:\"@imisTags\",Value:JSON.stringify(activities.IQA_iMISTags.ResultSet())},{Name:\"@removedTagOrdinals\",Value:String(activities.EndpointData.Output().Body.RemovedTagOrdinals ?? \"\")}])"}},{"$id":"143","name":"Timeout","expressions":{"$id":"144"}},{"$id":"145","name":"StrictlySelectOnly","expressions":{"$id":"146"}}],"propertyStorageProviders":{"$id":"147"}},{"$id":"148","activityId":"8f90676b-253a-48e3-a83e-22d64075c804","type":"BulkDataSourceOperation","displayName":"iMIS: Update Filename","x":40,"y":2850,"persistWorkflow":false,"loadWorkflowContext":false,"saveWorkflowContext":false,"properties":[{"$id":"149","name":"DataSource","expressions":{"$id":"150","Literal":"Party|Zen_CloudFiles_Storage|Multi"}},{"$id":"151","name":"DataSourceOperation","expressions":{"$id":"152","Literal":"Update"}},{"$id":"153","name":"CollectionToProcess","syntax":"JavaScript","expressions":{"$id":"154","JavaScript":"activities.SQL_Filename.ResultSet()"}},{"$id":"155","name":"KeyField","expressions":{"$id":"156"}},{"$id":"157","name":"SwitchOnStopwatch","expressions":{"$id":"158"}},{"$id":"159","name":"MaxDegreeOfParallelism","expressions":{"$id":"160"}},{"$id":"161","name":"DataSourceType","expressions":{"$id":"162","Literal":""}}],"propertyStorageProviders":{"$id":"163"}},{"$id":"164","activityId":"b39b90b3-3c5a-4cd9-874c-0553f68d1da2","type":"BulkDataSou