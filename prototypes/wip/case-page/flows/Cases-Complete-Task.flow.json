        {
          "activityId": "6ec81e89-9caa-4126-a760-2ba8b788902c",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_Validation",
          "displayName": "SQL - Validation and Timestamp",
          "description": null,
          "x": 40,
          "y": 542,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "syntax": null,
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "-- The task is a Zidebar note; its CaseOrdinal gives the case, so the page\r\n-- sends only the task's ordinal (TaskID) and the action.\r\nDECLARE @TaskOrd int = TRY_CAST(@TaskOrdinal AS int);\r\nDECLARE @CaseOrdinal int = (\r\n\tSELECT TOP 1 CaseOrdinal\r\n\tFROM ZideBar.Zen_CloudFiles_Notes\r\n\tWHERE Ordinal = @TaskOrd\r\n);\r\n\r\nDECLARE @EntityCode AS varchar(20) = COALESCE(\r\n  (SELECT OrgCode FROM [Cases].[i4u_UT_Cases] WHERE Ordinal = @CaseOrdinal),\r\n  (SELECT EntityCode FROM [ZenCrm].[Individuals] WHERE ImisId = @LoggedInUser),\r\n  (SELECT OrgCode FROM UnionTemplate.Entities WHERE IsDefault = 1) -- Final fallback, default org code\r\n);\r\nDECLARE @localTimestamp datetime = COALESCE([UnionTemplate].fn_GetDateTimeWithTimeZone(@EntityCode), GETUTCDATE());\r\n\r\nDECLARE @valid int = 1\r\nDECLARE @message varchar(4000) = ''\r\n\r\n-- check the action is one the task list sends\r\nIF @Action IS NULL OR @Action NOT IN ('Complete', 'Not Complete', 'In Progress')\r\n    SET @message += 'Action is not valid. | '\r\n\r\n-- check the task exists and belongs to a case\r\nIF @CaseOrdinal IS NULL OR NOT EXISTS (\r\n\tSELECT *\r\n\tFROM Cases.i4u_UT_Cases\r\n\tWHERE Ordinal = @CaseOrdinal\r\n)\r\n    SET @message += 'Task is not a case task. | '\r\n\r\n-- check if users entity matches the task's case\r\nIF NOT EXISTS (\r\n\tSELECT *\r\n\tFROM Cases.i4u_UT_Cases C\r\n\tINNER JOIN UnionTemplate.EntityAccess A\r\n\t\tON C.OrgCode = A.EntityCode\r\n\tWHERE C.Ordinal = @CaseOrdinal\r\n\t\tAND A.StaffimisID = @LoggedInUser\r\n)\r\n    SET @message += 'Unauthorised entity | '\r\n\r\nIF @message <> ''\r\n\tSET @valid = 0\r\n\r\n-- One row whether or not the task exists. Actioned and TaskStatus are the\r\n-- new values (the iMIS update's collection); Old* are as they were.\r\nSELECT\r\n\t@valid AS [Valid],\r\n\t@message AS [Message],\r\n\tCONVERT(varchar(23), @localTimestamp, 126) AS [Timestamp],\r\n\tN.Ordinal AS [Ordinal],\r\n\t@CaseOrdinal AS [CaseOrdinal],\r\n\tC.CaseID AS [CaseID],\r\n\tCAST(CASE WHEN @Action = 'Complete' THEN 1 ELSE 0 END AS bit) AS [Actioned],\r\n\t@Action AS [TaskStatus],\r\n\tN.Actioned AS [OldActioned],\r\n\tCAST(N.TaskStatus AS varchar(150)) AS [OldTaskStatus]\r\nFROM (SELECT 1 AS [One]) X\r\nLEFT JOIN ZideBar.Zen_CloudFiles_Notes N\r\n\tON N.Ordinal = @TaskOrd\r\nLEFT JOIN Cases.i4u_UT_Cases C\r\n\tON C.Ordinal = @CaseOrdinal;"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{\"Name\":\"@TaskOrdinal\",\"Value\":String((activities.EndpointData.Output().Body.TaskID) ?? \"\")},{\"Name\":\"@Action\",\"Value\":String((activities.EndpointData.Output().Body.Action) ?? \"\")},{\"Name\":\"@LoggedInUser\",\"Value\":String((activities.EndpointData.Output().Headers.loggedinpartyid) ?? \"\")}])"
              }
            },
