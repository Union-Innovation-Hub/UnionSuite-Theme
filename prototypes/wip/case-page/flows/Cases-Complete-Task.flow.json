        {
          "activityId": "d2e43184-a54c-460b-98d1-bc8361729882",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "SQL_TaskUpdate",
          "displayName": "SQL: CT Update - Zen_CloudFiles_Notes",
          "x": 40,
          "y": 1295,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "ExpectedResults",
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "UPDATE ZideBar.Zen_CloudFiles_Notes\r\nSET Actioned = CASE\r\n          WHEN @Action = 'Complete' THEN 1\r\n          ELSE 0\r\n     END,\r\n     TaskStatus = @Action,\r\n     LastUpdatedBy = @LoggedInUser,\r\n     LastUpdatedOn = @LocalTimestamp\r\nWHERE Ordinal = @TaskOrdinal\r\n\tAND CaseOrdinal = @CaseOrdinal\r\n\r\nSELECT\r\n     Ordinal,\r\n     Actioned,\r\n     TaskStatus\r\nFROM ZideBar.Zen_CloudFiles_Notes\r\nWHERE Ordinal = @TaskOrdinal"
              }
            },
            {
              "name": "Parameters",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "JSON.stringify([{\"Name\":\"@TaskOrdinal\",\"Value\":String((activities.SQL_Validation.ResultSet()[0].Ordinal) ?? \"\")},{\"Name\":\"@CaseOrdinal\",\"Value\":String((activities.SQL_Validation.ResultSet()[0].CaseOrdinal) ?? \"\")},{\"Name\":\"@Action\",\"Value\":String((activities.EndpointData.Output().Body.Action) ?? \"\")},{\"Name\":\"@LoggedInUser\",\"Value\":String((activities.EndpointData.Output().Headers.loggedinpartyid) ?? \"\")},{\"Name\":\"@LocalTimestamp\",\"Value\":String((activities.SQL_Validation.ResultSet()[0].Timestamp) ?? \"\")}])"
              }
            },
