        {
          "activityId": "323babb6-696c-484f-a380-5e4b66f55cc1",
          "type": "RunJavaScript",
          "name": "CreateLogContext",
          "displayName": "JS: Create Log Context",
          "description": null,
          "x": 40,
          "y": 1546,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// UPDATE LOG CONTEXT HERE\r\nvar endpoint = activities.EndpointData.Output();\r\nvar body = endpoint.Body;\r\nvar task = activities.SQL_Validation.ResultSet()[0]; // the task and its case, read before the update\r\n\r\nvar logContext = {\r\n    \"Note\": \"Case \" + task.CaseID + \": Set Task Status\", // UPDATE HERE\r\n    \"Table\": \"Zen_CloudFiles_Notes\", // UPDATE HERE\r\n    \"UpdateReason\": \"Edit\", // UPDATE HERE\r\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\r\n    \"sourceOrdinal\": String(task.Ordinal) // the task's ordinal\r\n}\r\n// UPDATE FIELDS YOU WANT TO COMPARE HERE - names must match the keys in logBody below\r\nvar fieldsToCompare = [\"Actioned\", \"TaskStatus\"];\r\n\r\n// The task's values, new and as they were (SQL_Validation reads them before\r\n// the update), under the Zen_CloudFiles_Notes column names.\r\nvar logBody = {\r\n    \"Actioned\": String(task.Actioned ?? \"\"),\r\n    \"TaskStatus\": String(body.Action ?? \"\"),\r\n    \"OldValue\": JSON.stringify({\r\n        \"Actioned\": String(task.OldActioned ?? \"\"),\r\n        \"TaskStatus\": String(task.OldTaskStatus ?? \"\")\r\n    })\r\n}\r\n\r\n// compile all variables into one object\r\nvar logChanges = {\r\n    \"logContext\": logContext, // DON'T CHANGE\r\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\r\n    \"body\": logBody,\r\n    \"profileID\": String(task.CaseID), // the case the change belongs to\r\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\r\n}\r\nsetVariable('logChanges', logChanges);"
              }
            }
          ],
          "propertyStorageProviders": {}
        },
