        {
          "activityId": "e0625150-9cfb-4244-a1dc-50203cab45c7",
          "type": "ExecuteSqlAgainstCloudToolz",
          "name": "Tags",
          "displayName": "Tags",
          "x": 0,
          "y": 300,
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "propertyStorageProviders": {},
          "properties": [
            {
              "name": "ExpectedResults",
              "expressions": {
                "Literal": "Result Set"
              }
            },
            {
              "name": "Script",
              "expressions": {
                "Literal": "-- The attachment tags, as the Zidebar tag editor (Zidebar: Tags) lists them:\r\n-- ordinals 1 to 11 are left out there too.\r\nSELECT [Ordinal], [TagName]\r\nFROM [ZideBar].[Zen_Tags]\r\nWHERE [Ordinal] > 11\r\nORDER BY [TagName]"
              }
            },
            {
              "name": "Parameters",
              "expressions": {}
            },
            {
              "name": "Timeout",
              "expressions": {}
            }
          ]
        },
        {
          "activityId": "0925d3be-8807-46aa-ad3e-bce428c9b988",
          "type": "WriteHttpResponse",
          "displayName": "Tag list",
          "persistWorkflow": false,
          "loadWorkflowContext": false,
          "saveWorkflowContext": false,
          "propertyStorageProviders": {},
          "properties": [
            {
              "name": "Content",
              "syntax": "JavaScript",
              "expressions": {
                "JavaScript": "// A bare list of {Ordinal, TagName}, read by the case page's attachment composer.\r\nvar rows = activities.Tags.ResultSet() || [];\r\nreturn JSON.stringify(rows.map(function (row) {\r\n  return {Ordinal: row.Ordinal, TagName: row.TagName};\r\n}));"
              }
            },
            {
              "name": "ContentType",
              "expressions": {
                "Literal": "application/json"
              }
            },
            {
              "name": "StatusCode",
              "expressions": {
                "Literal": "OK"
              }
            },
            {
              "name": "CharSet",
              "expressions": {
                "Literal": "utf-8"
              }
            },
            {
              "name": "ResponseHeaders",
              "expressions": {}
            }
          ],
