          "properties": [
            {
              "name": "Script",
              "syntax": "Literal",
              "expressions": {
                "Literal": "// UPDATE LOG CONTEXT HERE\r\nvar endpoint = activities.EndpointData.Output();\r\nvar body = endpoint.Body;\r\nvar staff = activities.SQL_Validation.ResultSet()[0]; // the staff row, read before the update\r\n\r\nvar logContext = {\r\n    \"Note\": \"Case \" + body.CaseID + \": Set Staff Role\", // UPDATE HERE\r\n    \"Table\": \"i4u_UT_Cases_Staff\", // UPDATE HERE\r\n    \"UpdateReason\": \"Edit\", // UPDATE HERE\r\n    \"workflowDefinitionId\": workflowDefinitionId, // DON'T UPDATE, VARIABLE IS PROVIDED BY CLOUDTOOLZ\r\n    \"sourceOrdinal\": String(body.StaffOrdinal) // the case staff row's ordinal\r\n}\r\n// UPDATE FIELDS YOU WANT TO COMPARE HERE - names must match the keys in logBody below\r\nvar fieldsToCompare = [\"StaffType\"];\r\n\r\n// The role, new and as it was (SQL_Validation reads it before the update),\r\n// under the i4u_UT_Cases_Staff column name.\r\nvar logBody = {\r\n    \"StaffType\": String(body.Role ?? \"\"),\r\n    \"OldValue\": JSON.stringify({ \"StaffType\": String(staff.OldStaffType ?? \"\") })\r\n}\r\n\r\n// compile all variables into one object\r\nvar logChanges = {\r\n    \"logContext\": logContext, // DON'T CHANGE\r\n    \"fieldsToCompare\": fieldsToCompare, // DON'T CHANGE\r\n    \"body\": logBody,\r\n    \"profileID\": String(body.CaseID), // the case the change belongs to\r\n    \"updatedByID\": endpoint.Headers.loggedinpartyid\r\n}\r\nsetVariable('logChanges', logChanges);"
              }
            },
