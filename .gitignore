# Dependencies
node_modules/

# Scratch / temporary working dirs
.tmp-*/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store

# Packaged theme archives (rebuilt from source)
Theme/**/*.zip

# Superseded research and disposable experiments (keep current/approved designs tracked)
/archive/
# Retired custom CCO iPart: implementation archived locally in archive/; its
# research and investigation docs live in prototypes/wip/cco-inline-loading/research/
/Custom CCO iPart/

# Generated guides and component previews; rebuild from maintained sources
/Theme/UnionSuite-Guides/Usage-Guide.html
/Theme/UnionSuite-Guides/Theme-Config.html
/Theme/UnionSuite-Guides/Theme-Config-*.html
/Theme/UnionSuite-Guides/Cases-Help.html
/references/*.html
!/references/index.html
# Approved unimplemented designs remain directly reviewable after checkout
!/references/Taskbar-Workshop.html
!/references/Recents-Workshop.html
# Authored studies without a separate generator: retain until classified
!/references/Convert-Icon-Preview.html
!/references/Task List Animations.html
# Single-file prototype exports; rebuild with node build-standalone.cjs
/prototypes/wip/contact-page-v3/Contact-Page-v3-Standalone.html
/prototypes/wip/case-page/Case-Page-Standalone.html
/prototypes/wip/membership-stats-filters/Membership-Stats-Filters-Standalone.html
# Live-page candidate embed; rebuild with node prototypes/wip/agreement-page/build-embed.cjs
/prototypes/wip/agreement-page/agreement-page-embed.html

# Local preview output and captures; retain existing maintained helper scripts
/.preview/*
!/.preview/*.cjs
!/.preview/*.js
!/.preview/*.py
!/.preview/README.md

# Minified upload copy of the theme; rebuild with tools/build-theme-dist.cjs
/dist/

# Built paste-in embeds; rebuild with each embed's build script
/embeds/finance-dashboard/dist/

# Built BeyondFormz exports; rebuild with the folder's build-form.cjs
/prototypes/wip/case-create-form/beyondformz/dist/

# Built staff help pages and chatbot JSON; rebuild with tools/build-user-guide.cjs
/docs/user-guide/dist/
